                    <li><a href="https://yandex.ru/maps/?text=Ресторан+ФаСоль+Гомель+Советская+36" target="_blank">Яндекс Карты</a></li>
                    <li><a href="https://maps.google.com/?q=ФаСоль+Гомель+Советская+36" target="_blank">Google Maps</a></li>
                    <li><a href="#">Instagram</a></li>
                    <li><a href="#">TripAdvisor</a></li>
                </ul>
